{
  "name": "scenario-runner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Scenario Runner - instructor console + student display for the UVM Rescue AEMT CCIT scenario JSON",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts scenarios",
    "pdf": "python3 tools/build_pdfs.py scenarios out",
    "e2e": "playwright test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
