{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uvm-rescue.local/ems-scenarios/actions.schema.json",
  "title": "Provider-action catalog (shared by all scenarios)",
  "description": "schema/actions.json: what a crew can do, grouped, with optional detail fields. Used by the Scenario Runner (log + timestamp) and tools/ems_scenario.py (PROVIDER ACTIONS page). Every field is optional when an action is logged.",
  "type": "object",
  "required": ["version", "groups", "actions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "description": { "type": "string" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string", "minLength": 1 } }
      }
    },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "action": {
      "type": "object",
      "required": ["id", "group", "label", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "group": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1, "description": "compact label for tight layouts" },
        "protocols": { "type": "array", "items": { "type": "string", "pattern": "^([0-9]{1,2}\\.[0-9]{1,2}[AP]?|A\\.[0-9])$" } },
        "common": { "type": "boolean", "description": "printed on every scenario's PROVIDER ACTIONS page (after the scenario's own actions)" },
        "note": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["select", "multi", "number", "text"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["select", "multi"] } } },
          "then": {
            "required": ["options"],
            "additionalProperties": false,
            "properties": {
              "id": true, "label": true, "kind": true,
              "options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "number" } } },
          "then": {
            "required": ["unit"],
            "additionalProperties": false,
            "properties": {
              "id": true, "label": true, "kind": true,
              "unit": { "type": "string" },
              "presets": { "type": "array", "items": { "type": "number" } },
              "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "text" } } },
          "then": { "additionalProperties": false, "properties": { "id": true, "label": true, "kind": true } }
        }
      ]
    }
  }
}
